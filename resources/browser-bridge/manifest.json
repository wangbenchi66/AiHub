{
  "manifest_version": 3,
  "name": "AiHub Bridge",
  "description": "同步浏览器所有站点的 Cookie 到本机 AiHub，不读取页面内容。",
  "version": "0.1.0",
  "key": "",
  "minimum_chrome_version": "110",
  "permissions": [
    "cookies",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "site-storage.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "AiHub Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
